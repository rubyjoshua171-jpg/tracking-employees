# Copy to .env.local for local development.
# Supabase project values are public client configuration, protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only values. Never prefix these with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=
CRON_SECRET=

# Optional Microsoft Graph integration for Teams meeting creation and reminder emails.
MICROSOFT_TENANT_ID=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_USER_ID=

# Optional: set the exact redirect URL used by Supabase email confirmation.
NEXT_PUBLIC_DEV_SUPABASE_REDIRECT_URL=
